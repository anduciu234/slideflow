# --- Research (optional: leave empty to use the free browser scraper) ---
APIFY_TOKEN=
# Apify actor used for TikTok research ("/" written as "~")
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper

# --- TikTok developer app (developers.tiktok.com) ---
# Add products: Login Kit + Content Posting API. Scopes: user.info.basic, video.upload, video.publish
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match a redirect URI registered on the app (Desktop platform allows localhost)
TIKTOK_REDIRECT_URI=http://localhost:5178/callback
# Optional: extra scopes for the stats dashboard (enable them on the app first, then re-run tiktok:login)
# TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list,video.upload,video.publish

# --- Image hosting for photo posts ---
# STORAGE=vercel copies slides into ./site/slides and redeploys (prefix verified with TikTok).
# STORAGE=s3 uses the S3_* settings below instead.
STORAGE=vercel
# TikTok photo posts only accept PULL_FROM_URL from a domain you've verified in the TikTok dev portal.
# Any S3-compatible bucket works; Cloudflare R2 + a custom domain is the cheap option.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix for the bucket, on your TikTok-verified domain (no trailing slash)
PUBLIC_BASE_URL=https://your-project.vercel.app
